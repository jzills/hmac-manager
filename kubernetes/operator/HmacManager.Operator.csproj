<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>HmacManager.Operator</RootNamespace>
    <Version>0.2.2</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="KubeOps.Operator" Version="11.5.0" />
    <!-- Source generator: keep it local to this project so its generated registration code
         does not flow into (and collide within) projects that reference the operator. -->
    <PackageReference Include="KubeOps.Generator" Version="11.5.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/HmacManager.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="HmacManager.Operator.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Microsoft.NET.Sdk (unlike Sdk.Web) does not auto-include appsettings.json as content,
         so without this the file is never published and Generic Host falls back to its
         unfiltered default log levels. -->
    <None Include="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
